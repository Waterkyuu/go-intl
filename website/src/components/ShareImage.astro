---
import { sitePath } from "./navigation";

const image = Astro.site && new URL(sitePath("go-intl.png"), Astro.site);
---

{image && (
  <>
    <meta property="og:image" content={image.href} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="go-intl logo" />
  </>
)}
