---
import { getCollection } from "astro:content";
import { sitePath } from "../components/navigation";
import Site from "../layouts/Site.astro";
import Home from "../components/Home";

const entries = await getCollection("docs");
const guides = entries
  .sort((a, b) => (a.data.sidebar.order ?? 0) - (b.data.sidebar.order ?? 0))
  .map(({ id, data }) => ({
    href: sitePath(`${id}/`),
    title: data.title,
    summary: data.description ?? "",
  }));
---

<Site
  title="go-intl · High-performance Go internationalization (i18n)"
  description="Localize Go terminal, desktop, and server apps with a shared catalog. Explore message formatting, fallback languages, and go-intl benchmarks against go-i18n."
>
  <Home guides={guides} />
</Site>
